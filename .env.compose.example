# Docker Compose stack — copy to `.env.compose` before `docker compose up` or `make compose-up`.
# Matches production dependencies (Postgres + Redis + async ARQ) without GCP secrets.

# --- Database ---
MEETING_ASSISTANT_DATABASE_URL=postgresql+psycopg://meeting_assistant:meeting_assistant@postgres:5432/meeting_assistant

# --- Async pipeline ---
MEETING_ASSISTANT_BATCH_PROCESSING_MODE=async
MEETING_ASSISTANT_JOB_QUEUE_PROVIDER=arq
MEETING_ASSISTANT_QUEUE_PROVIDER=redis
MEETING_ASSISTANT_REDIS_URL=redis://redis:6379/0

# --- Local-friendly providers (no OpenAI key required) ---
MEETING_ASSISTANT_EMBEDDING_PROVIDER=heuristic
MEETING_ASSISTANT_LLM_PROVIDER=heuristic
MEETING_ASSISTANT_QUERY_PROVIDER=heuristic
MEETING_ASSISTANT_ASR_PROVIDER=heuristic
MEETING_ASSISTANT_ASR_UPLOAD_BACKEND=local
MEETING_ASSISTANT_ASR_UPLOAD_DIR=/tmp/meeting-assistant/uploads/audio

# --- Tools (stubs) ---
MEETING_ASSISTANT_SLACK_PROVIDER=stub
MEETING_ASSISTANT_EMAIL_PROVIDER=stub
MEETING_ASSISTANT_CALENDAR_PROVIDER=stub
MEETING_ASSISTANT_JIRA_PROVIDER=stub

# --- Auth / CORS ---
MEETING_ASSISTANT_AUTH_ENABLED=false
MEETING_ASSISTANT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Readiness ---
MEETING_ASSISTANT_READINESS_CHECK_REDIS=true
MEETING_ASSISTANT_READINESS_CHECK_WORKER=true
MEETING_ASSISTANT_READINESS_CHECK_EMBEDDER=false

# --- Phase 13 integrations (dev key — local compose only) ---
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEETING_ASSISTANT_INTEGRATIONS_ENCRYPTION_KEY=LGSsEL6SaT94bRbNIta_sAKKnzFOnalNjqp4cROj78g=
MEETING_ASSISTANT_INTEGRATIONS_OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# Optional: override host ports (defaults in docker-compose.yml)
# COMPOSE_API_PORT=8000
# COMPOSE_WORKER_PORT=8081
# COMPOSE_POSTGRES_PORT=5432
# COMPOSE_REDIS_PORT=6379

# Optional: enable hosted OpenAI paths (uncomment and set key)
# MEETING_ASSISTANT_LLM_PROVIDER=openai
# MEETING_ASSISTANT_EMBEDDING_PROVIDER=openai
# MEETING_ASSISTANT_QUERY_PROVIDER=openai
# MEETING_ASSISTANT_LLM_OPENAI_API_KEY=sk-...
