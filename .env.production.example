# Production-shaped app settings (MEETING_ASSISTANT_*).
# Copy to `.env.production`, fill values, then:
#   export MEETING_ASSISTANT_ENV_FILE=.env.production
#   uv run uvicorn meeting_assistant.main:app --reload
#
# On Cloud Run these same names are set via `gcloud run deploy --set-env-vars` / `--set-secrets`.
# Makefile deploy targets map GCP Secret Manager → these env var names automatically.

# --- Database (Cloud SQL via unix socket on Cloud Run) ---
MEETING_ASSISTANT_DATABASE_URL=postgresql+psycopg://meeting_assistant:PASSWORD@/meeting_assistant?host=/cloudsql/PROJECT:REGION:INSTANCE
# Or point at a file instead of embedding the URL in this file:
# MEETING_ASSISTANT_DATABASE_URL_FILE=/path/to/database-url.txt

# --- Async pipeline ---
MEETING_ASSISTANT_BATCH_PROCESSING_MODE=async
MEETING_ASSISTANT_JOB_QUEUE_PROVIDER=arq
MEETING_ASSISTANT_QUEUE_PROVIDER=redis
MEETING_ASSISTANT_REDIS_URL=rediss://default:TOKEN@your-redis-host.upstash.io:6379

# --- OpenAI (hosted paths) ---
MEETING_ASSISTANT_EMBEDDING_PROVIDER=openai
MEETING_ASSISTANT_QUERY_PROVIDER=openai
MEETING_ASSISTANT_LLM_PROVIDER=openai
MEETING_ASSISTANT_ASR_PROVIDER=openai
MEETING_ASSISTANT_LLM_OPENAI_API_KEY=sk-...
# Or one shared key file for LLM + embedding + ASR:
# MEETING_ASSISTANT_OPENAI_API_KEY_FILE=/path/to/openai-api-key.txt

# --- Audio ---
MEETING_ASSISTANT_ASR_UPLOAD_BACKEND=gcs
MEETING_ASSISTANT_ASR_GCS_BUCKET=your-project-meeting-audio

# --- Auth ---
MEETING_ASSISTANT_AUTH_ENABLED=true
# Scoped keys: user_external_id:api_key (comma-separated for multiple users)
# MEETING_ASSISTANT_AUTH_API_KEYS=indra:your-postman-secret
# Or mount from Secret Manager on Cloud Run (see deploy/.env.prod GCP_AUTH_KEYS_SECRET)
# JWT login (frontend exchanges API key or dev credentials for Bearer token):
# MEETING_ASSISTANT_AUTH_JWT_SECRET=change-me-to-a-long-random-secret
# MEETING_ASSISTANT_AUTH_JWT_EXPIRY_SECONDS=3600
# MEETING_ASSISTANT_AUTH_LOGIN_ALLOW_DEV=false
# Distributed approval lock (enabled when AUTH_ENABLED + REDIS_URL):
# MEETING_ASSISTANT_APPROVAL_LOCK_TTL_SECONDS=120

# --- Worker readiness (async ARQ) ---
# MEETING_ASSISTANT_READINESS_CHECK_WORKER=true
# MEETING_ASSISTANT_WORKER_HEALTH_CHECK_INTERVAL_SECONDS=30

# --- Stale workflow alerting ---
# MEETING_ASSISTANT_STALE_WORKFLOW_ALERT_ENABLED=true
# MEETING_ASSISTANT_STALE_WORKFLOW_THRESHOLD_MINUTES=15
# Poll GET /admin/ops/stale-workflows from Cloud Scheduler; alert on log metric stale_workflow_detected

# --- Failed tool alerting ---
# MEETING_ASSISTANT_FAILED_TOOL_ALERT_ENABLED=true
# MEETING_ASSISTANT_FAILED_TOOL_ALERT_LOOKBACK_MINUTES=60
# Poll GET /admin/ops/failed-tools from Cloud Scheduler; alert on log metric failed_tool_detected

# --- Hardening ---
MEETING_ASSISTANT_LOG_JSON=true
MEETING_ASSISTANT_RATE_LIMIT_ENABLED=true
MEETING_ASSISTANT_READINESS_CHECK_REDIS=true

# --- OpenTelemetry tracing (optional — OTLP collector or Cloud Trace) ---
# MEETING_ASSISTANT_OTEL_ENABLED=true
# MEETING_ASSISTANT_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
# MEETING_ASSISTANT_OTEL_SERVICE_NAME=meeting-assistant
# MEETING_ASSISTANT_OTEL_WORKER_SERVICE_NAME=meeting-assistant-worker

# --- Jira REST API (COMMENTED OUT — deferred; see features.json tool-jira-live) ---
# MEETING_ASSISTANT_JIRA_PROVIDER=rest
# MEETING_ASSISTANT_JIRA_BASE_URL=https://your-org.atlassian.net
# MEETING_ASSISTANT_JIRA_USER_EMAIL=you@yourdomain.com
# MEETING_ASSISTANT_JIRA_API_TOKEN=...
# MEETING_ASSISTANT_JIRA_PROJECT_KEY=ENG
# MEETING_ASSISTANT_JIRA_DEFAULT_ISSUE_TYPE=Task
# MEETING_ASSISTANT_JIRA_API_TOKEN_FILE=/secrets/jira-api-token

# --- Tools (v1 deploy-level; Phase 13 adds per-user integrations — see ARCHITECTURE.md ADR-15) ---
# Outbound identity: Meeting Assistant app (bot / branded sender / assistant calendar), not user impersonation.

# --- Google Calendar (assistant-owned organizer; Phase 13: user invited as attendee) ---
MEETING_ASSISTANT_CALENDAR_PROVIDER=google
MEETING_ASSISTANT_CALENDAR_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
MEETING_ASSISTANT_CALENDAR_GOOGLE_CALENDAR_ID=assistant@yourdomain.com
MEETING_ASSISTANT_CALENDAR_ASSISTANT_ORGANIZER_NAME=Meeting Assistant
# Do not set CALENDAR_GOOGLE_IMPERSONATE_SUBJECT for per-user assistant calendar writes.
# Or mount service account JSON from Secret Manager / file on Cloud Run:
# MEETING_ASSISTANT_CALENDAR_GOOGLE_SERVICE_ACCOUNT_JSON_FILE=/secrets/google-calendar-sa.json

# --- Email (SendGrid — Meeting Assistant branded From; Phase 13: per-user recipient prefs in DB) ---
MEETING_ASSISTANT_EMAIL_PROVIDER=sendgrid
MEETING_ASSISTANT_EMAIL_SENDGRID_API_KEY=SG.xxxx
MEETING_ASSISTANT_EMAIL_FROM_ADDRESS=notifications@yourdomain.com
MEETING_ASSISTANT_EMAIL_FROM_NAME=Meeting Assistant
MEETING_ASSISTANT_EMAIL_DEFAULT_RECIPIENT=team@yourdomain.com
# Or mount API key from Secret Manager / file on Cloud Run:
# MEETING_ASSISTANT_EMAIL_SENDGRID_API_KEY_FILE=/secrets/sendgrid-api-key

# --- Slack (v1: deploy webhook; Phase 13: per-user workspace OAuth, bot posts as Meeting Assistant) ---
MEETING_ASSISTANT_SLACK_PROVIDER=webhook
MEETING_ASSISTANT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXXXXX
# Or mount from Secret Manager / file on Cloud Run:
# MEETING_ASSISTANT_SLACK_WEBHOOK_URL_FILE=/secrets/slack-webhook-url
# Bot token alternative (v1 single workspace):
# MEETING_ASSISTANT_SLACK_PROVIDER=api
# MEETING_ASSISTANT_SLACK_BOT_TOKEN=xoxb-...
# MEETING_ASSISTANT_SLACK_DEFAULT_CHANNEL=#meeting-assistant

# --- Phase 13 user integrations (encrypt OAuth tokens at rest) ---
# MEETING_ASSISTANT_INTEGRATIONS_ENCRYPTION_KEY=...
# MEETING_ASSISTANT_INTEGRATIONS_OAUTH_REDIRECT_BASE=https://your-api.run.app
# MEETING_ASSISTANT_SLACK_OAUTH_CLIENT_ID=
# MEETING_ASSISTANT_SLACK_OAUTH_CLIENT_SECRET=
# MEETING_ASSISTANT_GOOGLE_OAUTH_CLIENT_ID=
# MEETING_ASSISTANT_GOOGLE_OAUTH_CLIENT_SECRET=
