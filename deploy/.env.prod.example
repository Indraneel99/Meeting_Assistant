# Copy to deploy/.env.prod and fill in. Do not commit deploy/.env.prod.
#
# This file is read by the Makefile only (not by the Python app).
# Secret VALUES live in GCP Secret Manager; use GCP_* variables below to point at them.
# The app on Cloud Run always reads MEETING_ASSISTANT_* — Makefile maps this file → those names.
#
# Secret Manager → Cloud Run mapping (all wired by `make deploy-api` / `make deploy-worker`):
#
#   GCP secret name                      → MEETING_ASSISTANT_* env on Cloud Run
#   ─────────────────────────────────────────────────────────────────────────────
#   OPENAI_API_KEY                       → LLM / EMBEDDING / ASR OpenAI keys
#   meeting-assistant-api-keys           → AUTH_API_KEYS          (when AUTH_ENABLED=true)
#   AUTH_JWT_SECRET                      → AUTH_JWT_SECRET        (when AUTH_ENABLED=true)
#   INTEGRATIONS_ENCRYPTION_KEY          → INTEGRATIONS_ENCRYPTION_KEY
#   SLACK_OAUTH_CLIENT_SECRET            → SLACK_OAUTH_CLIENT_SECRET
#   GOOGLE_OAUTH_CLIENT_SECRET           → GOOGLE_OAUTH_CLIENT_SECRET
#   SENDGRID_API_KEY                     → EMAIL_SENDGRID_API_KEY (when EMAIL_PROVIDER=sendgrid)
#   GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON → CALENDAR_GOOGLE_SERVICE_ACCOUNT_JSON (when CALENDAR_PROVIDER=google)
#   SLACK_WEBHOOK_URL                    → SLACK_WEBHOOK_URL      (when SLACK_PROVIDER=webhook)
#   JIRA_API_TOKEN                       → JIRA_API_TOKEN         (when JIRA_PROVIDER=rest)
#   DB_PASSWORD                          → used to build DATABASE_URL (see below)

PROJECT_ID=your_project_id
REGION=your_region

# Cloud SQL Postgres (pgvector via Alembic migrations on app startup)
# Create once (v1 / cheapest — Enterprise edition, NOT Enterprise Plus):
#   make cloudsql-create
# Or upgrade tier later: db-g1-small (~1.7 GB RAM) if migrations feel slow.
CLOUDSQL_INSTANCE=meeting-assistant-db
DB_NAME=meeting_assistant
DB_USER=meeting_assistant
# Option A: set password here (used by make cloudsql-init and DATABASE_URL on deploy)
DB_PASSWORD=change-me-strong-password
# Option B: omit DB_PASSWORD and Makefile fetches from Secret Manager (GCP_DB_PASSWORD_SECRET)
GCP_DB_PASSWORD_SECRET=DB_PASSWORD

# Redis — Upstash requires TLS: use rediss:// (copy from Upstash console, not redis://)
# Still used for approval locks when AUTH_ENABLED=true. Optional after Pub/Sub migration if
# only the ARQ job queue used Redis (JOB_QUEUE_PROVIDER=pubsub removes ARQ/Redis job dispatch).
REDIS_URL=rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379

# --- Phase 14 — Pub/Sub batch job queue (replaces always-on ARQ worker on GCP) ---
# Local dev and Docker Compose keep JOB_QUEUE_PROVIDER=arq. GCP production:
# JOB_QUEUE_PROVIDER=pubsub
# PUBSUB_TOPIC=meeting-assistant-batch-jobs
# PUBSUB_PROJECT=your_project_id
# PUBSUB_SUBSCRIPTION=meeting-assistant-batch-push
# PUBSUB_PUSH_PATH=/internal/jobs/batch
# PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-push@your_project_id.iam.gserviceaccount.com
#
# Migration (after job-queue-pubsub + worker-pubsub-push code is deployed):
#   1. make pubsub-topic-create pubsub-push-sa-create
#   2. make deploy-worker   # min-instances=0 when JOB_QUEUE_PROVIDER=pubsub
#   3. make pubsub-iam pubsub-subscription-create   # or: make pubsub-setup
#   4. make deploy-api      # publishes to Pub/Sub instead of Redis/ARQ
#
# Rollback: set JOB_QUEUE_PROVIDER=arq, make deploy-api deploy-worker (restores min-instances=1).
# Makefile sets READINESS_CHECK_WORKER=false on API and worker when JOB_QUEUE_PROVIDER=pubsub.

JOB_QUEUE_PROVIDER=arq
PUBSUB_TOPIC=meeting-assistant-batch-jobs
PUBSUB_PROJECT=your_project_id
PUBSUB_SUBSCRIPTION=meeting-assistant-batch-push
PUBSUB_PUSH_PATH=/internal/jobs/batch
PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-push@your_project_id.iam.gserviceaccount.com
# Pub/Sub JWT aud claim = full push endpoint URL (must include PUBSUB_PUSH_PATH)
PUBSUB_PUSH_AUDIENCE=https://meeting-assistant-worker-REGION-PROJECT.run.app/internal/jobs/batch

# Required when using Memorystore from Cloud Run (omit for Upstash)
# VPC_CONNECTOR=meeting-assistant-connector

# GCS bucket for gs:// source_uri ASR reads
GCS_AUDIO_BUCKET=your-project-meeting-audio

# --- Auth ---
AUTH_ENABLED=true
GCP_AUTH_KEYS_SECRET=meeting-assistant-api-keys
GCP_AUTH_JWT_SECRET=AUTH_JWT_SECRET
# Secret value format for meeting-assistant-api-keys: user_external_id:api_key per line
#   external-alice:alice-secret-key
#   indra:your-admin-key

# --- Phase 13 — user integrations (OAuth + encrypted tokens) ---
GCP_INTEGRATIONS_ENCRYPTION_SECRET=INTEGRATIONS_ENCRYPTION_KEY
GCP_SLACK_OAUTH_CLIENT_SECRET=SLACK_OAUTH_CLIENT_SECRET
GCP_GOOGLE_OAUTH_CLIENT_SECRET=GOOGLE_OAUTH_CLIENT_SECRET
# Public OAuth settings (not secrets — from Slack/Google developer consoles)
INTEGRATIONS_OAUTH_REDIRECT_BASE=https://your-api-REGION-PROJECT.run.app
SLACK_OAUTH_CLIENT_ID=your-slack-app-client-id
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- OpenAI ---
GCP_OPENAI_SECRET=OPENAI_API_KEY

# --- Slack (deploy-level fallback; Phase 13 per-user OAuth is preferred) ---
# Use stub when testing external users with Integrations → Connect Slack
SLACK_PROVIDER=stub
# SLACK_PROVIDER=webhook
GCP_SLACK_WEBHOOK_SECRET=SLACK_WEBHOOK_URL
# SLACK_PROVIDER=api
# GCP_SLACK_BOT_TOKEN_SECRET=SLACK_BOT_TOKEN
# SLACK_DEFAULT_CHANNEL=#meeting-assistant

# --- SendGrid (deploy-level branded sender) ---
EMAIL_PROVIDER=sendgrid
GCP_SENDGRID_SECRET=SENDGRID_API_KEY
EMAIL_FROM_ADDRESS=you@gmail.com
EMAIL_FROM_NAME=Meeting Assistant
EMAIL_DEFAULT_RECIPIENT=you@gmail.com

# --- Google Calendar (assistant-owned organizer calendar) ---
CALENDAR_PROVIDER=google
GCP_CALENDAR_SA_SECRET=GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON
CALENDAR_GOOGLE_CALENDAR_ID=primary
CALENDAR_ASSISTANT_ORGANIZER_NAME=Meeting Assistant
# Required to invite attendees (external users included). Impersonate a dedicated
# Google Workspace mailbox for Meeting Assistant — NOT an end user's account.
# 1) Create assistant@yourdomain.com in Google Workspace
# 2) Enable Domain-Wide Delegation on the service account (GCP → SA → Show domain-wide delegation)
# 3) Admin Console → Security → API controls → Domain-wide delegation → add SA client ID
#    with scope: https://www.googleapis.com/auth/calendar
# 4) Set impersonate subject to the assistant mailbox:
CALENDAR_GOOGLE_IMPERSONATE_SUBJECT=assistant@yourdomain.com

# --- Jira (deferred; enable when ready) ---
JIRA_PROVIDER=stub
GCP_JIRA_API_TOKEN_SECRET=JIRA_API_TOKEN
# JIRA_PROVIDER=rest
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_USER_EMAIL=you@example.com
# JIRA_PROJECT_KEY=ENG
# JIRA_DEFAULT_ISSUE_TYPE=Task

# --- Frontend CORS (comma-separated; required if frontend is on another origin) ---
# CORS_ORIGINS=https://your-frontend.web.app,http://localhost:5173

# --- OpenTelemetry (optional) ---
# OTEL_ENABLED=true
# OTEL_EXPORTER_ENDPOINT=https://your-otlp-collector/v1/traces
# OTEL_SERVICE_NAME=meeting-assistant
# OTEL_WORKER_SERVICE_NAME=meeting-assistant-worker
