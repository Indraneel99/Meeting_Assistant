# Local defaults — copy to `.env` and fill in secrets.
# Production-shaped values — copy `.env.production.example` → `.env.production` and run:
#   export MEETING_ASSISTANT_ENV_FILE=.env.production

# --- Shared OpenAI key (optional; also used as fallback for LLM/embedding/ASR) ---
# OPENAI_API_KEY=sk-...
# MEETING_ASSISTANT_OPENAI_API_KEY_FILE=/path/to/openai-api-key.txt

# --- Local dev (defaults match config.py; uncomment to override) ---
# MEETING_ASSISTANT_DATABASE_URL=sqlite:///./meeting_assistant.db
# MEETING_ASSISTANT_EMBEDDING_PROVIDER=heuristic
# MEETING_ASSISTANT_LLM_PROVIDER=heuristic
# MEETING_ASSISTANT_QUERY_PROVIDER=heuristic
# MEETING_ASSISTANT_BATCH_PROCESSING_MODE=sync
# MEETING_ASSISTANT_JOB_QUEUE_PROVIDER=inprocess
# MEETING_ASSISTANT_QUEUE_PROVIDER=memory
# MEETING_ASSISTANT_AUTH_ENABLED=false
# MEETING_ASSISTANT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 13: per-user integrations — see ARCHITECTURE.md ADR-15/16 and features.json integrations-*
# Generate a production key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MEETING_ASSISTANT_INTEGRATIONS_ENCRYPTION_KEY=...
# MEETING_ASSISTANT_INTEGRATIONS_OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
